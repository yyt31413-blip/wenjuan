{
  "name": "desktop-order-survey",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "npm run preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "vitest run tests/d1.integration.test.ts",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview --ip 127.0.0.1 --port 3000",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test:e2e:worker": "playwright test --config playwright.worker.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.2.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4.1.0",
    "canvas-confetti": "^1.9.3",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@playwright/test": "^1.56.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "miniflare": "^5.20261019.2-beta",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "miniflare": {
      "undici": "^7.30.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
